APPFOLIO_CLIENT_ID=your_client_id
APPFOLIO_CLIENT_SECRET=your_client_secret
APPFOLIO_DATABASE=your_database_name

# Park Vista AppFolio (separate database)
PV_APPFOLIO_CLIENT_ID=your_pv_client_id
PV_APPFOLIO_CLIENT_SECRET=your_pv_client_secret
PV_APPFOLIO_DATABASE=your_pv_database_name

DEEPSEEK_API_KEY=your_deepseek_api_key
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Analytics configuration
# ADMIN_TOKEN: server-side secret. Used to protect the read endpoint and as the
# Authorization bearer token when forwarding to ANALYTICS_FORWARD_URL.
ANALYTICS_API_TOKEN=your_admin_token
# INGEST_TOKEN: public token sent by the mobile app. Must be different from
# ANALYTICS_API_TOKEN. It is bundled into the app and grants analytics ingest only.
ANALYTICS_INGEST_TOKEN=your_ingest_token
# EXPO_PUBLIC_ANALYTICS_INGEST_TOKEN=your_ingest_token
# ANALYTICS_ALLOWED_ORIGINS=https://central-control.vercel.app
# ANALYTICS_FORWARD_URL=https://your-private-server.example.com/analytics
# ANALYTICS_STORE=postgres      # dev default is jsonl; postgres is required on Vercel
# ANALYTICS_STORE_PATH=/tmp/analytics.jsonl

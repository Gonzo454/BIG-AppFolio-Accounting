APPFOLIO_CLIENT_ID=your_client_id
APPFOLIO_CLIENT_SECRET=your_client_secret
APPFOLIO_DATABASE=your_database_name

# Park Vista AppFolio (separate database)
PV_APPFOLIO_CLIENT_ID=your_pv_client_id
PV_APPFOLIO_CLIENT_SECRET=your_pv_client_secret
PV_APPFOLIO_DATABASE=your_pv_database_name

DEEPSEEK_API_KEY=your_deepseek_api_key
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Analytics configuration
# Required unless ANALYTICS_DISABLE_AUTH=true. Multiple tokens can be comma-separated.
# The same token must be provided by the mobile app (EXPO_PUBLIC_ANALYTICS_API_TOKEN)
# and the dashboard client (NEXT_PUBLIC_ANALYTICS_API_TOKEN).
ANALYTICS_API_TOKEN=your_analytics_api_token
NEXT_PUBLIC_ANALYTICS_API_TOKEN=your_analytics_api_token
# EXPO_PUBLIC_ANALYTICS_API_TOKEN=your_analytics_api_token
# ANALYTICS_DISABLE_AUTH=false
# ANALYTICS_ALLOWED_ORIGINS=https://central-control.vercel.app
# ANALYTICS_STORE_PATH=/tmp/analytics.jsonl
# ANALYTICS_FORWARD_URL=https://your-private-server.example.com/analytics
# ANALYTICS_MAX_EVENTS=10000
